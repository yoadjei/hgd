# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# tool caches
.pytest_cache/
.ruff_cache/

# run artefacts. the small json files under results/ are tracked on purpose: they
# are the gate evidence for each phase and regenerate deterministically from the
# runner that wrote them. phase1_gate.json was previously ignored by name, which
# meant the evidence for kill condition C, the precondition for every causal claim
# here, only ever existed on the ephemeral disk of whatever machine ran it.
# the bulk per-episode logs are a different matter and stay out.
results/runs/
*.jsonl

# appworld download and experiment outputs
data/
experiments/outputs/

# local tooling and one-off prompts, kept on disk but out of the repo
.claude/
claude_code_prompt.md
